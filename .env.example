# Copy to .env.local for local development:  cp .env.example .env.local
# Never commit .env or .env.local.

# --- Required ---
NEXT_PUBLIC_SITE_URL=https://pm-travelagency.com
# Canonicals, sitemap and Open Graph always use https://pm-travelagency.com (src/lib/company.ts).

# --- RFQ (Milestone 3). The site runs without these; the form will refuse
#     to accept a submission rather than silently drop one. ---

# PostgreSQL 16, running as its own service - never inside the web container.
DATABASE_URL=

# Where RFQ notifications are sent.
B2B_EMAIL=b2b@pm-travelagency.com
CONTACT_EMAIL=contact@pm-travelagency.com

# SMTP for the internal notification and the sender's acknowledgement.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Private S3-compatible storage for RFQ attachments.
# The bucket must NOT be public. Files are served only via signed URLs.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Salt for hashing IP addresses used in rate limiting and audit records.
# Set a long random value in production. We never store a raw IP address.
IP_HASH_SALT=

# --- CRM connection (docs/api-contract.md section 2). Values must be IDENTICAL
#     to the CRM's. Server-side only: never prefix these with NEXT_PUBLIC_. ---
CRM_API_URL=https://crm.pm-travelagency.com/api/public/v1
CRM_API_KEY=            # = WEBSITE_API_KEY in the CRM
CRM_PREVIEW_KEY=        # = WEBSITE_PREVIEW_KEY in the CRM
CRM_LEADS_KEY=          # = WEBSITE_LEADS_KEY in the CRM
REVALIDATE_SECRET=      # = WEBSITE_REVALIDATE_SECRET in the CRM

# Cloudflare Turnstile site key (public; the secret lives in the CRM as CAPTCHA_SECRET).
# Docker: pass as a build argument, it is baked into the browser bundle.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
