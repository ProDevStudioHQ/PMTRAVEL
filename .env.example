# Copy to .env.local for local development:  cp .env.example .env.local
# Never commit .env or .env.local.

# --- Required ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- RFQ (Milestone 3). The site runs without these; the form will refuse
#     to accept a submission rather than silently drop one. ---

# PostgreSQL 16, running as its own service - never inside the web container.
DATABASE_URL=

# Where RFQ notifications are sent.
B2B_EMAIL=b2b@pm-travelagency.com
CONTACT_EMAIL=contact@pm-travelagency.com

# SMTP for the internal notification and the sender's acknowledgement.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Private S3-compatible storage for RFQ attachments.
# The bucket must NOT be public. Files are served only via signed URLs.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Salt for hashing IP addresses used in rate limiting and audit records.
# Set a long random value in production. We never store a raw IP address.
IP_HASH_SALT=
